# OpenAI 兼容的翻译 API。
# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL_ID=deepseek-v4-flash

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL_ID=

# 可选。传给 Chat Completions 的 max_tokens。
# 大文档整文件翻译时，如果 finish_reason=length 且 completion_tokens 约等于默认上限，
# 可以调高这个值。
# OPENAI_MAX_TOKENS=120000

# 可选。限制单次翻译的文档数量。
# TRANSLATE_LIMIT=10

# 可选。并发翻译数量，默认是 3。
# TRANSLATE_CONCURRENCY=3

# 可选。设置为 1 时只打印将要翻译的文件，不调用 API，也不写入文件。
# TRANSLATE_DRY_RUN=1
